---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import About from '../components/About.astro';
import Stack from '../components/Stack.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import { profile } from '../data/profile';
---

<Base
  title={`${profile.fullName} (${profile.handle}) — generalist computer scientist & software engineer`}
  description={`Portfolio of ${profile.fullName} (${profile.handle}): nearly two decades from formal methods and verified compilers to core auth at Microsoft and Bazel at Google. Languages, projects, and contact — ${profile.location}.`}
>
  <Hero />
  <Ticker />
  <About />
  <Stack />
  <Experience />
  <Projects />
  <Education />
  <Contact />
</Base>
