const links = [
  { href: `mailto:${profile.email}`, label: profile.email, icon: 'envelope', box: '0 0 16 16' },
  { href: profile.website, label: 'etud.io', icon: 'globe', box: '0 0 16 16' },
  { href: profile.gitlab, label: 'gitlab.com/parcha', icon: 'gitlab', box: '0 0 24 24' },
  { href: profile.kde, label: 'invent.kde.org/parcha', icon: 'kde', box: '0 0 24 24' },
  { href: profile.github, label: 'github.com/parcha', icon: 'github', box: '0 0 24 24' },
  { href: profile.linkedin, label: 'linkedin.com/in/alexmarquezperez', icon: 'linkedin', box: '0 0 16 16' },
];
---

<section class="hero" aria-labelledby="hero-name">
  <span class="hero__pi" aria-hidden="true">π</span>
  <div class="container hero__inner">
    <p class="kicker mono">portfolio · résumé · est. 2007</p>
    <h1 id="hero-name" class="hero__name">{profile.name}</h1>
    <p class="hero__family">
      {profile.familyNames.map((surname) => (
        <span>{surname}</span>
      ))}
    </p>
    <ul class="hero__links">
      {
        links.map((link) => (
          <li>
            <a
              class="hero__link"
              href={link.href}
              aria-label={link.label}
              data-label={link.label}
            >
              <svg viewBox={link.box} aria-hidden="true" focusable="false">
                <path d={icons[link.icon]} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="hero__alias mono">
      also <a href={profile.gitlab}>@{profile.handle}</a> · {profile.pronouns} · AKA 艾宇睿龙 (𑀆𑀚𑀻𑀯)
    </p>
    <p class="hero__tag">{profile.tagline}</p>
    <div class="hero__cta">
      <a class="btn btn--solid" href="#contact">get in touch</a>
      <a class="btn" href="#work">see work experience</a>
      <span class="hero__loc mono">{profile.location}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 14vh, 9rem) clamp(3rem, 8vh, 6rem);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    opacity: 0.25;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 15%, black, transparent 78%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .kicker {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero__name {
    margin: 0;
    font-size: clamp(3.2rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero__family {
    margin: -0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.7ch;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .hero__family span {
    font-size: 2em;
    line-height: 1;
  }

  .hero__family span:nth-child(2) { font-size: 1.8em; }
  .hero__family span:nth-child(3) { font-size: 1.62em; }
  .hero__family span:nth-child(4) { font-size: 1.45em; }
  .hero__family span:nth-child(5) { font-size: 1.3em; }
  .hero__family span:nth-child(6) { font-size: 1.16em; }
  .hero__family span:nth-child(7) { font-size: 1.03em; }
  .hero__family span:nth-child(8) { font-size: 0.9em; }

  .hero__links {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
  }

  .hero__link {
    position: relative;
    display: block;
    color: var(--muted);
    transition: color 0.15s ease;
  }

  .hero__link svg {
    display: block;
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
  }

  .hero__link:hover,
  .hero__link:focus-visible {
    color: var(--accent);
  }

  .hero__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .hero__link::after {
    content: attr(data-label);
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 0.45rem);
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--bg-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--ink);
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
    z-index: 1;
  }

  .hero__link:hover::after,
  .hero__link:focus-visible::after {
    opacity: 1;
  }

  .hero__alias {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  .hero__alias a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero__alias a:hover {
    color: var(--accent);
  }

  .hero__tag {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.6vw, 1rem);
    line-height: 1.9;
    color: var(--muted);
    max-width: 62ch;
  }

  .hero__cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero__loc {
    color: var(--muted);
    font-size: 0.8rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.6rem 1rem;
  }

  .hero__pi {
    position: absolute;
    right: -8vw;
    top: 50%;
    transform: translateY(-52%);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 55vw;
    line-height: 1;
    color: color-mix(in oklab, var(--accent) 6%, transparent);
    pointer-events: none;
    user-select: none;
  }
</style>
