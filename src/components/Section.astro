---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="section__head">
      <h2 id={`${id}-title`}>{title}</h2>
    </header>
    <slot />
  </div>
</section>
