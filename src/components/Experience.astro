---
import Section from '../components/Section.astro';

interface Job {
  company: string;
  role: string;
  where: string;
  when: string;
  notes: string[];
}

const jobs: Job[] = [
  {
    company: 'Microsoft',
    role: 'Senior Software Engineer',
    where: 'Remote',
    when: 'July 2024 – September 2025',
    notes: [
      'Contributed to the Torus team, the core authorization and authentication service used across Microsoft’s products and customers.',
      'Led the resolution of security vulnerabilities across the ControlPlane, Torus, RemoteAccess, and TorusPhoneApp repositories, for application security.',
      'Collaborated across teams to build an AI system that automated routine security vulnerability resolution and supported major dependency upgrades requiring code rewrites.',
      'On-call for the Service Auth team: 12-hour days for 14 days, about five times a year.',
      'Delivered technical talks on languages, build systems, packaging, optimization, and reliability across teams.',
    ],
  },
  {
    company: 'Google',
    role: 'Software Engineer L5',
    where: 'Atlanta, GA',
    when: 'June 2021 – May 2023',
    notes: [
      'Roboleaf: migrated Android’s bespoke Soong- and Kati-based build system toward Bazel.',
      'Implemented the Python binary build migration conversion, moving components from legacy workflows to Bazel.',
      'Built and maintained C and C++ object, static, and shared library build infrastructure, and its test infrastructure.',
      'Served in rotation as the broader Bazel “sheriff”: on-call triage and coordination of build and infrastructure issues.',
      'Mentored junior engineers on C and C++ linking, programming languages, and build systems.',
    ],
  },
  {
    company: 'Raytheon',
    role: 'Cyber Engineer II — TS Cleared',
    where: 'Greenville, SC',
    when: 'November 2015 – March 2019',
    notes: [
      'Enhanced the runtime dynamic linker with additional capabilities.',
      'Created a secure, soft real-time embedded Linux OS and its build, deployment, provisioning, and maintenance system.',
      'Designed the architecture of the primary program monitoring a widely used industrial bus for intrusions and anomalies — performance, fault tolerance, verifiability, soft real-time behavior.',
      'Wrote an internal SCons build-system module in C++ obfuscating byte streams against static and dynamic analysis and active reverse engineering.',
      'Built PowerPC system emulation and test infrastructure.',
      'Wrote firmware for an AVR ATmega32U4-based keyboard, including a proof of concept for malware propagation to a host.',
      'Reverse engineered a heavily threaded x86-64 Linux network management server (SSL + CORBA RPC) to work around its licensing.',
    ],
  },
  {
    company: 'DG Technology Group',
    role: 'Senior Software Engineer',
    where: 'Jupiter, FL',
    when: 'July 2014 – April 2015',
    notes: [
      'Re-architected a proprietary real-time brokerage and trading platform: multiple C++ modules sharing a Postgres database.',
      'Re-implemented the risk-management algorithms to strengthen trading analytics; Python + SciPy, with Pandas and Seaborn visualization.',
    ],
  },
  {
    company: 'Northeastern University',
    role: 'PhD Researcher',
    where: 'Boston, MA',
    when: 'May 2012 – December 2013',
    notes: [
      'Programming languages research: static analysis through abstract interpretation, verified compilers, software contracts, temporal logics, and automata.',
      'Contributed to a DARPA-funded Android security project, applying that research to software analysis and verification.',
    ],
  },
  {
    company: 'Georgia Institute of Technology',
    role: 'Graduate Researcher',
    where: 'Atlanta, GA',
    when: 'May 2011 – December 2012',
    notes: [
      'DARPA UHPC: informal and formal program analyses evaluating challenge problems, supporting objective assessment of next-generation architectures.',
      'Built Cetus-UHPC: a Cetus PA/S2S derivative, with reference implementations in a semantically restricted C subset, yielding abstract and algebraic metrics.',
    ],
  },
  {
    company: 'Georgia Institute of Technology',
    role: 'Undergraduate Researcher',
    where: 'Atlanta, GA',
    when: 'April 2009 – May 2010',
    notes: [
      'Co-developed AFABL: a programming language for efficient, flexible agent-based simulations aimed at non-programmers.',
      'Runtime reinforcement learning adapts agent behavior, lifting most of the burden of statically programming it.',
    ],
  },
  {
    company: 'Cisco Systems',
    role: 'Software Engineer Intern',
    where: 'Boulder, CO',
    when: 'May 2007 – August 2007',
    notes: [
      'Supported the ASA (Adaptive Security Appliance) codebase migration to Safer C; implemented and optimized the Safer C standard library.',
      'Assisted developer policy migration to updated security and engineering standards; audited the codebase’s Linux kernel components for security and reliability.',
    ],
  },
];
---

<Section id="work" title="Work">
  <ol class="jobs">
    {
      jobs.map((job) => (
        <li class="entry">
          <div class="entry__when">
            <span class="entry__date">{job.when}</span>
            <span class="entry__where">{job.where}</span>
          </div>
          <div class="entry__body">
            <h3 class="entry__title">
              {job.role} <span class="entry__dash">—</span>
              <span class="entry__company">{job.company}</span>
            </h3>
            <ul class="job__notes">
              {job.notes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3.5rem;
  }

  .entry__date {
    color: var(--ink);
  }

  .entry__company {
    color: var(--accent);
  }

  .entry__dash {
    color: var(--muted);
    font-weight: 400;
  }

  .job__notes {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
    color: var(--muted);
  }

  .job__notes li::marker {
    color: var(--accent);
  }
</style>
