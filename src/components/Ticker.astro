---
const items = [
  'C',
  'C++',
  'SCALA',
  'JAVA',
  'PYTHON 2&3',
  'RUST',
  'SQL (POSTGRES)',
  'BASH',
  'GAWK',
  'RACKET & REDEX',
  'LATEX',
  'GO',
  'C#',
  'IDRIS2',
  'TYPE SYSTEMS',
  'FORMAL VERIFICATION',
  'OPERATIONAL SEMANTICS',
  'STATIC ANALYSIS',
  'COMPILERS & TOOLCHAINS',
  'ELF DYNAMIC LINKERS',
  'BUILD SYSTEMS',
  'X86',
  'ARM',
  'AVR',
  'LINUX KERNEL & USERSPACE',
  'GCC & LLVM',
  'SAFE C',
  'MIL-STD-1553',
];

/* Decorative: this content is repeated in the Stack section, which is
   what assistive tech should use. */
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {
      Array.from({ length: 2 }, () => (
        <span class="ticker__group">
          {items.map((item) => (
            <span class="ticker__item mono">{item}</span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 45s linear infinite;
    will-change: transform;
  }

  .ticker__group {
    display: flex;
    flex-shrink: 0;
  }

  .ticker__item {
    padding: 0.8rem 1.1rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    border-right: 1px solid var(--line);
    white-space: nowrap;
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
</style>
