---
import Section from '../components/Section.astro';
import { profile } from '../data/profile';
---

<Section id="about" title="About">
  <div class="about">
    <p class="lede">
      Senior software engineer and scientist, with nearly two decades of experience
      researching, designing, formalizing, prototyping, implementing, and maintaining
      solutions to complex problems.
    </p>
    <p>
      A computer science generalist, specializing in security, programming languages, build
      systems, compilers, static analysis, and systems architecture. Led vulnerability
      remediation at Microsoft and Android build-system migration at Google.
    </p>
    <p>
      Collaborative, language-agnostic contributor committed to open source. Tech lead for
      teams of two to eight. Communicative to the point of “overly&nbsp;so”. Has taught and
      mentored in a variety of roles.
    </p>
    <p class="about__status mono">
      currently: {profile.availability}.
    </p>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: 1.25rem;
    max-width: 65ch;
  }

  .about p {
    margin: 0;
  }

  .lede {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .about__status {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 2px;
    background: var(--bg-soft);
    font-size: 0.9rem;
    color: var(--ink);
  }
</style>
