---
import Section from '../components/Section.astro';

interface NamePart {
  label: string;
  href?: string;
}

interface Project {
  name: string | NamePart[];
  href?: string;
  meta: string;
  when: string;
  description: string;
}

const projects: Project[] = [
  {
    name: [
      { label: 'captiond', href: 'https://captiond.etud.io' },
      { label: ' & ' },
      { label: 'Kaption', href: 'https://kaption.etud.io' },
    ],
    meta: 'C++20 · Qt/QML · KDE Frameworks; PipeWire · whisper.cpp',
    when: '2026 – present',
    description:
      'Fully local live captioning for anything a Linux desktop plays or hears, split into a toolkit-free daemon and its frontends. <i>captiond</i> captures system audio and microphones via PipeWire, transcribes on whatever GPU or CPU backend it discovers at runtime, and streams captions, split into committed text and a revisable tail, over a JSON Lines socket and D-Bus. <i>Kaption</i> (KDE Plasma) and <i>Qaption</i> (Qt-only) render them as a click-through overlay, sharing all QML and with differences minimally isolated to a single platform-integration class.',
  },
  {
    name: 'ConcBuilder',
    href: 'https://gitlab.com/parcha/concbuilder',
    meta: 'C++23 · header-only',
    when: '2025 – present',
    description:
      'Concurrent sequence library: the ConcTree and ConcRope, grow-only sequences with three synchronization modes — single-threaded mutable, reference-counted copy-on-write, and epoch-based RCU for lock-free reader snapshots. After Prokopec & Odersky (LCPC 2015).',
  },
  {
    name: 'Agda MCP',
    href: 'https://gitlab.com/parcha/agda-mcp',
    meta: 'Rust',
    when: '2026 – present',
    description:
    'Fully-featured MCP server for Agda daemons.',
  },
  {
    name: 'Atlas',
    href: 'https://gitlab.com/parcha/atlas',
    meta: 'C++ · OpenMP',
    when: '2017 – present',
    description:
      'Charts and “decharts” information with π as an atlas: steganography, and lossless archival and expensive transmission — e.g. intra-solar-system.',
  },
  {
    name: 'OOCFA2',
    href: 'https://github.com/parcha',
    meta: 'Scala · Racket/Redex',
    when: 'May 2011 – August 2013',
    description:
      'First higher-order static analysis of Dalvik bytecode: 4,000 LOC of production-quality Scala, safe JVM reflection, and formal verification in Racket and Redex. Advisors: Pande, Shivers, and Isbell. M.S. plus part of the Ph.D.',
  },
  {
    name: 'Cetus-UHPC',
    meta: 'Java · program analysis',
    when: '2012',
    description:
      'Cetus PA/S2S derivative: algebraic metrics of parallelizability and memory footprint for a restricted-C subset, for the DARPA UHPC project. Supervisors: Dr. Mark Richards, Mr. Dan Campbell.',
  },
  {
    name: 'Multi-way branch prediction',
    meta: 'C · C++ · ARM assembly',
    when: '2009',
    description:
      'An ISA-native, C-like switch statement and a novel ARM multi-way branch predictor; modified gem5, and modified clang/LLVM middle and back ends. With Dr. Milos Prvulović.',
  },

];
---

<Section id="projects" title="Selected projects">
  <div class="cards">
    {
      projects.map((project) => (
        <article class="card">
          <p class="card__meta mono">
            <span>{project.meta}</span>
            <span>· {project.when}</span>
          </p>
          <h3 class="card__name">
            {typeof project.name === 'string' ? (
              project.href ? (
                <a href={project.href}>
                  {project.name} <span class="card__arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                project.name
              )
            ) : (
              project.name.map((part) =>
                part.href ? (
                  <a href={part.href}>
                    {part.label} <span class="card__arrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span>{part.label}</span>
                )
              )
            )}
          </h3>
          <p class="card__desc" set:html={project.description}></p>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--bg-soft);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card__name {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .card__name a {
    color: var(--ink);
    text-decoration: none;
  }

  .card__name a:hover {
    color: var(--accent);
  }

  .card__arrow {
    color: var(--accent);
    font-weight: 400;
  }

  .card__desc {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
