---
import Section from '../components/Section.astro';

interface Project {
  name: string;
  href?: string;
  meta: string;
  when: string;
  description: string;
}

const projects: Project[] = [
  {
    name: 'ConcBuilder',
    href: 'https://gitlab.com/parcha/concbuilder',
    meta: 'C++23 · header-only',
    when: '2025 – present',
    description:
      'Concurrent sequence library: the ConcTree and ConcRope, grow-only sequences with three synchronization modes — single-threaded mutable, reference-counted copy-on-write, and epoch-based RCU for lock-free reader snapshots. After Prokopec & Odersky (LCPC 2015).',
  },
  {
    name: 'Atlas',
    href: 'https://gitlab.com/parcha/atlas',
    meta: 'C++ · OpenMP',
    when: '2017 – present',
    description:
      'Charts and “decharts” information with π as an atlas: steganography, and lossless archival and expensive transmission — e.g. interplanetary communication.',
  },
  {
    name: 'OOCFA2',
    href: 'https://github.com/parcha',
    meta: 'Scala · Racket/Redex',
    when: 'May 2011 – August 2013',
    description:
      'First higher-order static analysis of Dalvik bytecode: 4,000 LOC of production-quality Scala, safe JVM reflection, and formal verification in Racket and Redex. Advisors: Pandé, Shivers, and Isbell. M.S. plus part of the Ph.D.',
  },
  {
    name: 'Cetus-UHPC',
    meta: 'Java · program analysis',
    when: '2012',
    description:
      'Cetus PA/S2S derivative: algebraic metrics of parallelizability and memory footprint for a restricted-C subset, for the DARPA UHPC project. Supervisors: Dr. Mark Richards, Mr. Dan Campbell.',
  },
  {
    name: 'Multi-way branch prediction',
    meta: 'C · C++ · ARM assembly',
    when: '2009',
    description:
      'An ISA-native, C-like switch statement and a novel ARM multi-way branch predictor; modified gem5, and modified clang/LLVM middle and back ends. With Dr. Milos Prvulović.',
  },
];
---

<Section id="projects" num="03" title="Selected projects">
  <div class="cards">
    {
      projects.map((project) => (
        <article class="card">
          <p class="card__meta mono">{project.meta} · {project.when}</p>
          <h3 class="card__name">
            {project.href ? (
              <a href={project.href}>
                {project.name} <span class="card__arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              project.name
            )}
          </h3>
          <p class="card__desc">{project.description}</p>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--bg-soft);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .card__meta {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card__name {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .card__name a {
    color: var(--ink);
    text-decoration: none;
  }

  .card__name a:hover {
    color: var(--accent);
  }

  .card__arrow {
    color: var(--accent);
    font-weight: 400;
  }

  .card__desc {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
